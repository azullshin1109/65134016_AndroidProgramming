<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <TextView
        android:id="@+id/textViewHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="THÊM CÔNG VIỆC"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvLabelName"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="Tên CV:"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@+id/editTextTenCV"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/editTextTenCV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:hint="Nhập tên việc..."
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvLabelName"
        app:layout_constraintTop_toBottomOf="@+id/textViewHeader" />

    <TextView
        android:id="@+id/tvLabelMess"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="Mô tả:"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@+id/editTextMess"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/editTextMess"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Nội dung công việc..."
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvLabelMess"
        app:layout_constraintTop_toBottomOf="@+id/editTextTenCV" />

    <TextView
        android:id="@+id/tvLabelPrio"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="Ưu tiên:"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@+id/editTextPrio"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/editTextPrio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Mức độ (1, 2, 3)"
        android:inputType="number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvLabelPrio"
        app:layout_constraintTop_toBottomOf="@+id/editTextMess" />

    <TextView
        android:id="@+id/tvLabelDate"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="Ngày:"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@+id/editTextDate"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/editTextDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="dd/mm/yyyy"
        android:inputType="date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvLabelDate"
        app:layout_constraintTop_toBottomOf="@+id/editTextPrio" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@android:drawable/ic_menu_save"
        app:backgroundTint="#2196F3"
        android:tint="@android:color/white"/>

</androidx.constraintlayout.widget.ConstraintLayout>